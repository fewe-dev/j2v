{
    "name": "fewedev/j2v",
    "description": "JSON to VAR converter",
    "keywords": [
        "json",
        "var"
    ],
    "homepage": "https://github.com/fewe-dev/j2v",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/fewe-dev/j2v/issues",
        "source": "https://github.com/fewe-dev/j2v"
    },
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "fewedev/base": "^1.5",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8 || ^5.0.3",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "j2v"
    ],
    "scripts": {
        "fix": "vendor/bin/php-cs-fixer fix app",
        "cs": "vendor/bin/php-cs-fixer fix app --dry-run --verbose --diff",
        "ps": "vendor/bin/phpstan analyse",
        "phar": "~/.config/composer/vendor/bin/box compile",
        "bin": "~/.config/composer/vendor/bin/phpacker build",
        "deb": "cd build/linux && mkdir -p debian/usr/bin && cp linux-x64 debian/usr/bin/papdy && dpkg-deb --build debian papdy.deb && rm -rf debian/usr && cd ../..",
        "build": [
            "~/.config/composer/vendor/bin/box compile",
            "~/.config/composer/vendor/bin/phpacker build",
            "cd build/linux && mkdir -p debian/usr/bin && cp linux-x64 debian/usr/bin/papdy && dpkg-deb --build debian papdy.deb && rm -rf debian/usr && cd ../.."
        ]
    }
}
